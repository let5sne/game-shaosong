{
  "name": "the-register",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "simulate": "node scripts/simulate.mjs",
    "test": "node --test",
    "balance": "node scripts/simulate.mjs 300 --all --check",
    "balance:economy": "node scripts/simulate.mjs 100 --all --check --economy",
    "verify:dist": "node scripts/verify/dist-smoke.mjs",
    "verify:browser": "node scripts/verify/browser-smoke.mjs",
    "verify:browser:mobile": "node scripts/verify/browser-smoke.mjs --mobile",
    "lint": "eslint .",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "i18n:audit:strict": "node scripts/i18n-audit.mjs --strict",
    "verify:browser:en": "node scripts/verify/browser-smoke.mjs --lang=en",
    "verify:iframe": "node scripts/verify/iframe-smoke.mjs",
    "itch:package": "node scripts/itch-package.mjs",
    "itch:publish": "node scripts/itch-publish.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "vite": "^6.3.5"
  }
}
